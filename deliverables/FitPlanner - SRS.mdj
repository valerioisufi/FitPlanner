							"lineStyle": 3,
							"points": "3663:911;3454:916",
							"showVisibility": true,
							"nameLabel": {
								"$ref": "AAAAAAGdmxRhdWjejww="
							},
							"stereotypeLabel": {
								"$ref": "AAAAAAGdmxRhdWjf7Ek="
