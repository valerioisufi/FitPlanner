								},
								{
									"_type": "EdgeLabelView",
									"_id": "AAAAAAGd9PqT+4oQR5s=",
									"_parent": {
										"$ref": "AAAAAAGd9PqT+4oNb+o="
									},
									"model": {
										"$ref": "AAAAAAGd9PqT+4oL1XQ="
									},
									"visible": false,
									"font": "Arial;13;0",
									"parentStyle": false,
									"left": 1126,
									"top": 2490,
									"height": 13,
									"alpha": -1.5707963267948966,
